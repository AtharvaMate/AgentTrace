# Environment Variables for AgentTrace
# Copy this file to .env and fill in your values

# --- PostgreSQL ---
POSTGRES_USER=agenttrace
POSTGRES_PASSWORD=agenttrace_secret
POSTGRES_DB=agenttrace

# --- Gemini API (optional but recommended) ---
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Backend ---
DATABASE_URL=postgresql://agenttrace:agenttrace_secret@localhost:5432/agenttrace
